{
	"name": "hashtrack",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"apps/pi/extensions"
		]
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"catalog": {
		"@types/bun": "^1.4.3",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "bun build",
		"build:pi": "bun run --cwd apps/pi build",
		"build:opencode": "bun run --cwd apps/opencode build",
		"build:web": "bun run --cwd packages/local-web build",
		"test:extensions": "bun test packages/core packages/lib apps/pi apps/opencode && bun run test:gui",
		"test:gui": "bun test --conditions=browser apps/opencode/src/gui-stats.test.ts",
		"test:web": "bun run --cwd packages/local-web test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
