{
	"name": "@hashtrack/pi",
	"version": "0.1.1",
	"type": "module",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"keywords": [
		"hashtrack",
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/HeapSoftGmbH/hashtrack"
	},
	"scripts": {
		"build": "bun run --cwd ../.. build:web && bun build extensions/index.ts --outdir dist --target=bun --external @earendil-works/pi-coding-agent && rm -rf dist/local-web && cp -r ../../packages/local-web/dist dist/local-web",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.2.0",
		"@hashtrack/core": "workspace:*",
		"@hashtrack/lib": "workspace:*",
		"@types/bun": "^1.4.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.2.0"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
