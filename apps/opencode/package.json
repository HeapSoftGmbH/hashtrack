{
	"name": "@hashtrack/opencode",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./rpc": "./dist/rpc.js",
		"./tui": "./dist/tui.js",
		"./gui-experimental": "./dist/gui-experimental.cjs"
	},
	"files": [
		"dist",
		"web"
	],
	"keywords": [
		"hashtrack",
		"opencode-plugin"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/HeapSoftGmbH/hashtrack"
	},
	"scripts": {
		"build": "bun run build:server && bun run build:rpc && bun run build:tui && bun run build:web && bun run build:gui",
		"build:server": "bun build src/index.ts --outdir dist --target=bun --external @opencode/plugin --external effect",
		"build:rpc": "bun build src/rpc.ts --outdir dist --target=bun --external @opencode/plugin/rpc --external effect",
		"build:tui": "bun build src/tui.tsx --outdir dist --target=bun --external @opencode/plugin/tui --external @opentui/core --external @opentui/solid --external solid-js --external effect",
		"build:web": "bun run --cwd ../../packages/local-web build --outDir ../../apps/opencode/web --emptyOutDir",
		"build:gui": "vite build --config vite.config.gui.ts",
		"prepack": "bun run build"
	},
	"peerDependencies": {
		"@opencode/plugin": "^2.2.1",
		"@opentui/core": ">=0.6.6",
		"@opentui/solid": ">=0.6.6",
		"solid-js": ">=1.9.0"
	},
	"devDependencies": {
		"@hashtrack/core": "workspace:*",
		"@hashtrack/lib": "workspace:*",
		"@opencode/plugin": "2.2.1",
		"@opencode/theme": "2.2.1",
		"@opentui/core": "0.7.0",
		"@opentui/solid": "0.7.0",
		"@types/bun": "^1.4.3",
		"solid-js": "^1.9.17",
		"vite": "^7.3.7",
		"vite-plugin-solid": "^2.11.10"
	}
}
